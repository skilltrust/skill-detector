# Build output
bin/
dist/

# macOS
.DS_Store

# Vendor (if used). Anchored to the repo root: an unanchored pattern also
# swallows testdata fixtures that model a vendored skill, and those must be
# committed (git add -f is reserved for fixture CLAUDE.md in this repo).
/vendor/

.codex/
.claude/
.opencode/
_bmad/
_bmad-output/
AGENTS.md
CLAUDE.md

# Engineering knowledge base — local only. Only the contributor-facing dev
# guide is published. Excludes the *contents* of docs/, not the directory
# itself, so the re-include below works (git cannot re-include a file whose
# parent directory is excluded).
docs/*
!docs/development-guide.md

# Agent scratch: per-task briefs and reports
.agent-scratch/

# scripts/corpus-baseline.sh default output dirs — third-party skill
# packages cloned by --fetch; never commit them on this public repo.
.corpus/
.corpus-results/
# Local dev worktrees (see docs/runbooks/, superpowers workflow)
.worktrees/
