# Build output
bin/
dist/

# macOS
.DS_Store

# Vendor (if used). Anchored to the repo root: an unanchored pattern also
# swallows testdata fixtures that model a vendored skill, and those must be
# committed. Every pattern here that could match a fixture name must stay
# anchored, for the same reason — a fixture that silently stops being
# tracked is a test that silently stops running.
/vendor/

.claude/

# Engineering knowledge base — local only, because this repo is public.
# Excludes the *contents* of docs/, not the directory itself, so the
# re-includes below work (git cannot re-include a file whose parent
# directory is excluded).
#
# The re-included set is exactly what an external agent needs to work in a
# fresh clone, written in general terms. Everything else under docs/ is
# internal and stays unpublished. This list is allow-only by design: adding
# a new doc publishes nothing until it is named here, and a file is added
# here only after it has been read for anything that should not be public.
docs/*
!docs/README.md
!docs/architecture.md
!docs/glossary.md
!docs/product-context.md
!docs/cross-repo.md
!docs/development-guide.md
!docs/st-129-evidence-matrix.md

# Local scratch
.agent-scratch/

# scripts/corpus-baseline.sh default output dirs — third-party skill
# packages cloned by --fetch; never commit them on this public repo.
.corpus/
.corpus-results/
# Local dev worktrees
.worktrees/

.superpowers/

# Amp orb portal metadata
.amp/portals/*
